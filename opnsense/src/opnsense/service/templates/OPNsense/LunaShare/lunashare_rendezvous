{% if helpers.exists('OPNsense.lunashare.general.enabled') and OPNsense.lunashare.general.enabled == '1' %}
lunashare_rendezvous_enable="YES"
lunashare_rendezvous_args="-p {{ OPNsense.lunashare.general.port|default('47830') }}{% if OPNsense.lunashare.general.listen %} -b {{ OPNsense.lunashare.general.listen }}{% endif %} --max-devices {{ OPNsense.lunashare.general.maxdevices|default('200') }}{% if OPNsense.lunashare.general.rooms %} -r /usr/local/etc/lunashare/rooms.conf{% endif %}{% if OPNsense.lunashare.general.relay|default('1') == '0' %} --no-relay{% endif %}{% if OPNsense.lunashare.general.relaylimit|default('0') != '0' %} --relay-limit {{ OPNsense.lunashare.general.relaylimit }}{% endif %}"
{% else %}
lunashare_rendezvous_enable="NO"
{% endif %}
