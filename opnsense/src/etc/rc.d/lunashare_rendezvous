#!/bin/sh
#
# PROVIDE: lunashare_rendezvous
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# lunashare_rendezvous_enable (bool): YES to run the LunaShare rendezvous server
# lunashare_rendezvous_args (str):    server options (written by the OPNsense template)
# lunashare_rendezvous_linkcert (str): refid of the certificate for the link pages (exported before start)

. /etc/rc.subr

name=lunashare_rendezvous
rcvar=lunashare_rendezvous_enable

load_rc_config $name

: ${lunashare_rendezvous_enable:="NO"}
: ${lunashare_rendezvous_args:="-p 47830"}
: ${lunashare_rendezvous_user:="nobody"}

# The pid file belongs to the daemon(8) supervisor: stopping it also stops the server, and -r restarts the
# server should it ever exit unexpectedly. -S/-T log to syslog.
# rc.subr starts the whole thing as ${name}_user (nobody) - so no daemon -u here, and the pid file lives in a
# directory owned by that user.
piddir="/var/run/lunashare"
pidfile="${piddir}/${name}.pid"
start_precmd="${name}_prestart"
procname="daemon"
command="/usr/sbin/daemon"
command_args="-r -S -T lunashare -P ${pidfile} /usr/local/bin/lunashare-rendezvous ${lunashare_rendezvous_args}"

lunashare_rendezvous_prestart()
{
    install -d -o "${lunashare_rendezvous_user}" -m 0755 "${piddir}"
    install -d -o "${lunashare_rendezvous_user}" -m 0700 /var/db/lunashare  # offline messages (sealed)
    # links for anyone: the chosen certificate from the trust store, readable by the server's user only
    if [ -n "${lunashare_rendezvous_linkcert}" ]; then
        /usr/local/opnsense/scripts/OPNsense/LunaShare/export_cert.php "${lunashare_rendezvous_linkcert}" \
            /usr/local/etc/lunashare/links.crt /usr/local/etc/lunashare/links.key "${lunashare_rendezvous_user}" ||
            warn "LunaShare: could not export the links certificate"
    fi
}

run_rc_command "$1"
