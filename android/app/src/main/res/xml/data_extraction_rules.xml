<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the same as backup_rules.xml, for the cloud backup and for moving to a new phone -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cache/" />
    </device-transfer>
</data-extraction-rules>
