diff --git a/libavformat/hls.c b/libavformat/hls.c
index 62473a1..c90b93e 100644
--- a/libavformat/hls.c
+++ b/libavformat/hls.c
@@ -664,6 +664,18 @@ static int open_url(AVFormatContext *s, AVIOContext **pb, const char *url,
     if (!proto_name)
         proto_name = avio_find_protocol_name(url);
 
+    /* LunaShare: FFmpeg is built without its own network protocols - the host's io_open fetches http(s) URLs, so
+     * they are recognised by name here instead of by a protocol that isn't compiled in */
+    if (!proto_name) {
+        const char *u = url;
+        if (av_strstart(u, "crypto", NULL) && (u[6] == '+' || u[6] == ':'))
+            u += 7;
+        if (av_strstart(u, "https:", NULL))
+            proto_name = "https";
+        else if (av_strstart(u, "http:", NULL))
+            proto_name = "http";
+    }
+
     if (!proto_name)
         return AVERROR_INVALIDDATA;
 
